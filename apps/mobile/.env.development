# apps/mobile, DEVELOPMENT (Expo). Committed: only a local address, no secrets.
# A phone can't reach "localhost" on your laptop: `pnpm dev:all` sets this to
# your laptop's LAN address for you. Running Expo by hand on a device, put
# EXPO_PUBLIC_API_URL=http://<your-lan-ip>:8000 in `.env.development.local`.
EXPO_PUBLIC_API_URL=http://localhost:8000
