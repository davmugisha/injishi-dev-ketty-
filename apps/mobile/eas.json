{
  "cli": {
    "version": ">= 26.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "environment": "development",
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.23.2",
      "pnpm": "12.3.4",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "environment": "preview",
      "channel": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "node": "22.23.2",
      "pnpm": "12.3.4",
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "node": "22.23.2",
      "pnpm": "12.3.4"
    }
  }
}
