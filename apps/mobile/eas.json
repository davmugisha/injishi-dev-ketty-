{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-demo.injishi.com",
        "EXPO_PUBLIC_WEB_URL": "https://www-demo.injishi.com",
        "EXPO_UNSTABLE_TREE_SHAKING": "1",
        "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.injishi.com",
        "EXPO_PUBLIC_WEB_URL": "https://www.injishi.com",
        "EXPO_UNSTABLE_TREE_SHAKING": "1",
        "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
