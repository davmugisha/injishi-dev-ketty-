{
  "expo": {
    "name": "Injishi",
    "slug": "injishi-mobile",
    "owner": "rayaniraguha",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "injishi",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF7F9",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "rw.injishi.mobile"
    },
    "android": {
      "package": "rw.injishi.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#EEF7F9"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/injishi-short-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EEF7F9",
          "dark": {
            "image": "./assets/brand/injishi-short-white-1024.png",
            "backgroundColor": "#030707"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Injishi opens your photos only when you choose a picture to attach, such as a repair photo or your ID at check in.",
          "cameraPermission": "Injishi uses the camera only when you take a picture to attach, such as a repair photo or your ID at check in.",
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "injishi",
          "project": "injishi-mobile",
          "url": "https://de.sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db86eb15-d1d3-4152-a9a4-fe3879ea7d91"
      }
    }
  }
}
