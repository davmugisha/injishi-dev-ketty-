{
  "name": "@injishi/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:web": "expo export --platform web --output-dir dist-web",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run --silent lint:biome && pnpm run --silent lint:eslint",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "node --test \"scripts/*.test.mjs\"",
    "palette:check": "node scripts/palette-check.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "update:publish": "node scripts/publish-update.mjs",
    "eas-build-post-install": "pnpm --filter \"@injishi/mobile^...\" run --if-present build"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.11",
    "@expo-google-fonts/figtree": "0.4.1",
    "@gorhom/bottom-sheet": "5.2.9",
    "@injishi/data": "workspace:*",
    "@injishi/db": "workspace:*",
    "@injishi/design-tokens": "workspace:*",
    "better-auth": "1.6.11",
    "drizzle-orm": "0.45.4",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "heroui-native": "1.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.2"
  },
  "devDependencies": {
    "@expo/fingerprint": "~0.20.14",
    "@types/react": "19.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "typescript": "5.9.3"
  }
}
