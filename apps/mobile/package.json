{
  "name": "@injishi/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:web": "expo export --platform web --output-dir dist-web",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run --silent lint:biome && pnpm run --silent lint:eslint",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "node --test \"scripts/*.test.mjs\" \"src/**/*.test.ts\"",
    "palette:check": "node scripts/palette-check.mjs",
    "icons:gen": "node scripts/gen-icons.mjs",
    "icons:check": "node scripts/gen-icons.mjs --check",
    "check:ci": "node scripts/check-ci.mjs",
    "update:publish": "node scripts/publish-update.mjs",
    "eas-build-post-install": "pnpm --filter \"@injishi/mobile^...\" run --if-present build"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.11",
    "@expo-google-fonts/figtree": "0.4.1",
    "@gorhom/bottom-sheet": "5.2.14",
    "@injishi/api-client": "workspace:*",
    "@injishi/contracts": "workspace:*",
    "@injishi/data": "workspace:*",
    "@injishi/db": "workspace:*",
    "@injishi/design-tokens": "workspace:*",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "better-auth": "1.6.11",
    "drizzle-orm": "0.45.4",
    "expo": "~58.0.22",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.20",
    "expo-web-browser": "~58.0.7",
    "heroui-native": "1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.13.1"
  },
  "devDependencies": {
    "@expo/fingerprint": "~0.21.8",
    "@gravity-ui/icons": "2.22.1",
    "@types/react": "19.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "typescript": "6.0.3"
  }
}
