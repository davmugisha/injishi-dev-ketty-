# Origin of the Injishi API (NestJS on Fastify), for when admin starts reading
# from it. Keep the variable name identical across web, pms and admin.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origin of the public web app (:3000). The sidebar links out to it, so a wrong
# value sends staff to the wrong deployment rather than failing visibly.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# This console's own public origin, used to build the absolute url sign-in
# returns to (src/middleware.ts). It must also appear in web's redirect
# allowlist, or the round trip is refused. NEXT_PUBLIC_WEB_URL above is where
# the one sign-in screen lives.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
