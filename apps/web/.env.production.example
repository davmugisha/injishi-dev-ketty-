# apps/web, PRODUCTION. Not filled in by hand: the Docker build takes these as
# build arguments from Dokploy (infra/docker/docker-compose.dokploy.yml,
# infra/docker/DOKPLOY.md). NEXT_PUBLIC_* values are baked into the build.

NEXT_PUBLIC_API_URL=https://api.injishi.com
NEXT_PUBLIC_SITE_URL=https://www.injishi.com
NEXT_PUBLIC_WEB_URL=https://www.injishi.com
NEXT_PUBLIC_PMS_URL=https://app.injishi.com
NEXT_PUBLIC_INJISHI_ENVIRONMENT=production
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Server side only, inside the Docker network.
OPERATOR_APP_URL=http://app:3002
INTERNAL_API_URL=http://injishi-api:8000
