{
  "name": "@injishi/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev --port 3000",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "node --test \"tests/*.test.mjs\"",
    "clean": "rimraf .next",
    "tokens:sync": "node scripts/sync-theme-tokens.mjs",
    "css:app": "node scripts/gen-app-css.mjs",
    "img:twins": "node scripts/gen-avif-twins.mjs",
    "img:sizes": "node scripts/fix-img-sizes.mjs",
    "img:avif": "node scripts/avif-sources.mjs",
    "img": "node scripts/gen-avif-twins.mjs && node scripts/fix-img-sizes.mjs && node scripts/avif-sources.mjs",
    "icons": "node scripts/gen-pwa-icons.mjs",
    "test:sw": "pnpm dlx tsx scripts/test-sw-cache-policy.mjs",
    "regen": "node scripts/gen-app-css.mjs && node scripts/gen-avif-twins.mjs && node scripts/fix-img-sizes.mjs && node scripts/avif-sources.mjs && node scripts/gen-pwa-icons.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@injishi/auth": "workspace:*",
    "@injishi/contracts": "workspace:*",
    "@injishi/qr": "workspace:*",
    "@injishi/ui": "workspace:@injishi/web-ui@*",
    "@injishi/utils": "workspace:*",
    "@paper-design/shaders-react": "^0.0.80",
    "lucide-react": "1.23.0",
    "maplibre-gl": "^6.11.2",
    "next": "15.5.24",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.1.0",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@injishi/design-tokens": "workspace:*",
    "@next/eslint-plugin-next": "^16.3.3",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "22.15.29",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "serwist": "^9.5.11",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.2",
    "typescript": "5.8.3"
  }
}
