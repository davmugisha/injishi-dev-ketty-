# apps/web, DEVELOPMENT (`next dev`). Committed: only local addresses, no secrets.
# Next reads it on `pnpm web:dev`. To change a value on your machine only, put
# it in `.env.development.local` (gitignored). Production values come from the
# deploy (see .env.production.example).

# The API on this laptop (`pnpm api:dev`, or `pnpm api:dev:test` for the local stack).
NEXT_PUBLIC_API_URL=http://localhost:8000

# This app's own origin, and the web origin links and sign-in return to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# The operator app (apps/app) on its own origin, as app.injishi.com is in
# production. Web's /sign-in hands off to it, and signed-in operators,
# landlords, officers and staff open their home there.
NEXT_PUBLIC_PMS_URL=http://localhost:3002
