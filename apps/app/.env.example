# Origin of the Injishi API (NestJS on Fastify). The PMS client reads
# /api/v1/me/* from here — see src/pms/data/me.ts.
#
# Without this, the app falls back to the dev origin below. It is deliberately
# NOT same-origin: the API is a separate service, and pointing at the Next
# server just returns 404 on every page load.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origin of the web app (:3000), which hosts the ONE sign-in screen. The gate in
# src/middleware.ts sends a signed-out visitor there. There is deliberately no
# sign-in screen in this app: one Better Auth instance, one OTP contract.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# This app's own public origin, used to build the absolute url sign-in returns
# to. Read from here rather than from the request, because behind a proxy the
# request origin is the internal address and a browser sent back to it lands
# nowhere. It must also appear in web's redirect allowlist, or the round trip
# is refused and the visitor is dropped on the marketplace home page.
# Served as a zone under the web origin, so the public address IS the web
# address (the rewrite in apps/web/next.config.ts forwards /w/* here).
NEXT_PUBLIC_PMS_URL=http://localhost:3000
