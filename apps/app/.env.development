# apps/app, DEVELOPMENT (`next dev`). Committed: only local addresses, no secrets.
# To change a value on your machine only, put it in `.env.development.local`
# (gitignored). Production values come from the deploy (.env.production.example).

# The API on this laptop, for the browser and for this app's server.
NEXT_PUBLIC_API_URL=http://localhost:8000
INJISHI_API_URL=http://localhost:8000

# Web (the marketplace) on :3000, and this app on its own origin, :3002, as
# app.injishi.com is in production. Web's /sign-in hands off to this app.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_PMS_URL=http://localhost:3002
# The origin this app's server names when it calls the API (on CORS_ORIGINS).
INJISHI_API_ORIGIN=http://localhost:3002
