{
  "name": "@injishi/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev --port 3002",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start --port 3002",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run --silent lint:biome && pnpm run --silent lint:eslint",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "tsx --test \"tests/*.test.ts\" && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "data:coverage": "node scripts/data-coverage.mjs"
  },
  "dependencies": {
    "@gravity-ui/icons": "2.22.1",
    "@heroui-pro/react": "1.0.0-beta.10",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@injishi/auth": "workspace:*",
    "@injishi/contracts": "workspace:*",
    "@injishi/data": "workspace:*",
    "@injishi/db": "workspace:*",
    "@injishi/product-hr": "workspace:*",
    "@injishi/ui": "workspace:*",
    "@injishi/utils": "workspace:*",
    "@internationalized/date": "3.12.4",
    "@number-flow/react": "0.6.2",
    "@react-aria/utils": "3.34.1",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "maplibre-gl": "^6.11.2",
    "motion": "14.1.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "nuqs": "2.10.2",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-map-gl": "^8.1.3",
    "react-resizable-panels": "4.14.5",
    "react-stately": "3.51.0",
    "recharts": "3.10.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
