{
  "name": "@injishi/api",
  "version": "0.1.0",
  "private": true,
  "description": "Injishi backend: NestJS modular monolith (HTTP + WS) and BullMQ worker",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "worker": "node dist/main.js --worker",
    "worker:dev": "cross-env INJISHI_PROCESS=worker nest start --watch --config nest-cli.worker.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest && node --test \"scripts/*.test.mjs\"",
    "madge": "madge --circular --extensions ts src",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "db:migrate": "node scripts/migrate.mjs",
    "seed:geography": "node scripts/seed-geography.mjs",
    "seed:content": "node scripts/seed-content.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "db:seed": "node scripts/seed-sample.mjs",
    "db:seed:ia-verify": "node scripts/seed-ia-verify.mjs",
    "verify:role-nav": "node scripts/verify-role-nav.mjs",
    "verify:ops-reads": "node scripts/verify-ops-reads.mjs",
    "verify:walk-in": "node scripts/verify-walk-in.mjs",
    "verify:guest-stay": "node scripts/verify-guest-stay.mjs",
    "verify:ebm-invoice": "node scripts/verify-ebm-invoice.mjs",
    "seed:catalogue": "node scripts/seed-catalogue.mjs",
    "verify:authz": "node scripts/verify-authz.mjs",
    "verify:authz:http": "node scripts/verify-authz-http.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@injishi/auth": "workspace:*",
    "@injishi/contracts": "workspace:*",
    "@injishi/qr": "workspace:*",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/node": "^10.74.0",
    "better-auth": "1.6.11",
    "bullmq": "^5.56.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.45.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^10.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "madge": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "ts-jest": "^29.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
