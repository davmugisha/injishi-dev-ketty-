# server/api runtime configuration: the REFERENCE. Every variable the API
# reads is explained here. You don't copy this file; you use one per
# environment (2026-10-24), picked by APP_ENV (src/shared/config/env-files.ts):
#
#   .env.development   hosted dev services        `pnpm api:dev`        gitignored,
#                                                                         from .env.development.example
#   .env.test          local disposable stack     `pnpm api:dev:test`   committed, local values only
#                      and the tests              `pnpm dev:stack[:reset]`
#   .env.production    production                 Dokploy injects it;   see .env.production.example
#
# APP_ENV unset follows NODE_ENV (production, test, else development). Scripts
# (seeds, verify) read .env.test unless APP_ENV names another. Variables set in
# the shell or by Docker always win over the file.
#
# The values below are the old single-file defaults for the local stack in
# infra/docker/docker-compose.yml.

NODE_ENV=development
# http | worker (worker can also be selected with the --worker flag)
INJISHI_PROCESS=http
PORT=8000

DATABASE_URL=postgres://injishi:injishi@localhost:5432/injishi

# --- Which platform this process is (ADR-043) -------------------------------
# Leave both UNSET locally. Unset INJISHI_ENVIRONMENT means `demo` outside
# NODE_ENV=production, so `pnpm dev:stack` then `pnpm api:dev` gives you the
# demo shape: the fixed code 123456, the seeded personas, the persona picker.
# A demo process refuses to boot unless its database carries the sample marker
# that `pnpm dev:stack` writes (`mark-sample-database.mjs --sample`).
#
# INJISHI_ENVIRONMENT=production runs this laptop as production instead: random
# codes (read them in Mailpit), no personas. It still runs on a sample database,
# unless INJISHI_SAMPLE_DATA=off (below) keeps the database empty.
#
# Deployed stacks pin both in their compose file, never here: production
# `production` + `real`, staging `production` + `sample`, demo `demo` + `sample`.
# INJISHI_ENVIRONMENT=
# INJISHI_DATABASE_KIND=

# --- A second local stack, beside this one (mobile spec 0001) -------------------
# Leave these unset in the main checkout. A git worktree sets all of them, and
# shifts DATABASE_URL, REDIS_PORT, SMTP_URL, PORT and BETTER_AUTH_URL to match,
# so its containers, volumes and ports never touch the main checkout's.
# `pnpm dev:stack` and `pnpm dev:all` read them; the API never does. The
# defaults are shown.
#
# INJISHI_SAMPLE_DATA=off makes the stack only migrate: the database is never
# marked sample and never seeded, so it stays empty and needs
# INJISHI_ENVIRONMENT=production. The mobile worktree runs this way, with no
# demo data at all. Leave INJISHI_DATABASE_KIND unset even so: `real` is a
# deployed stack's promise, and the API then refuses a mock payment adapter.
# INJISHI_SAMPLE_DATA=on
# INJISHI_COMPOSE_PROJECT=docker
# INJISHI_MINIO_PORT=9000
# INJISHI_MINIO_CONSOLE_PORT=9001
# INJISHI_MAILPIT_PORT=8025
# INJISHI_METRO_PORT=8081

# Redis (BullMQ). A managed provider hands out ONE variable carrying host,
# port, user, password and scheme together — Railway calls it REDIS_URL — so
# that is what wins when it is set. The discrete pair below is the dev stack's
# spelling and is used only when REDIS_URL is empty. Setting the pair alone
# against a managed Redis is how a deploy ends up talking to 127.0.0.1 while
# every queue quietly stops draining.
# REDIS_URL=redis://default:password@redis.railway.internal:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Cookie signing secret. REQUIRED in production, min 32 chars (this placeholder
# is rejected there). Generate: `openssl rand -base64 32`.
COOKIE_SECRET=dev-only-secret
# Mixed into every kiosk PIN hash (ADR-058, 058-time AC-TM11). REQUIRED, min 32
# chars, on the production platform; unset falls back to a fixed dev pepper
# anywhere else. Changing it invalidates every PIN already set.
HR_PIN_PEPPER=
# Seals landlords' bank account numbers (rentals payout accounts, AES-256-GCM).
# REQUIRED on the production platform: base64 of exactly 32 bytes
# (`openssl rand -base64 32`); unset falls back to a fixed dev key anywhere else.
# Losing it makes every stored bank account number unreadable.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
# Comma-separated allowed origins (web :3000, the app :3002). Credentials are always
# enabled, so this is REQUIRED in production - the API refuses to boot without it
# rather than fall back to accepting any origin. Also feeds Better Auth's
# trustedOrigins (CSRF), so both checks always agree.
#
# This list is a real interface, not incidental config (Spec 0004, D-f). Every
# browser app reaches the API cross origin via NEXT_PUBLIC_API_URL, so an app
# whose origin is missing here cannot fetch AND cannot authenticate. The pms
# app (:3002) was absent until it grew a data layer, and the symptom was a
# silent 404 that never mentioned CORS - so when a new browser app appears,
# add its origin here in the same change.
#
# Each stack lists only its OWN apps' origins. The demo is a separate stack
# with a separate API (ADR-043), so production's list never names a demo origin.
#
# Ports do not count for cookies: :3002 and :8000 are different ORIGINS (so
# CORS applies) but the same SITE (so the session cookie survives the hop).
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Which proxy hops may name the client in X-Forwarded-For, and so what
# request.ip (every address keyed rate limit) says. Off when unset: a laptop
# talks to the API directly. A hop count (1 to 5) or a comma list of IPs and
# CIDRs; `true` is refused. Each deploy compose file sets it to its own proxy
# chain (src/shared/config/trust-proxy.ts).
# TRUST_PROXY=1

LOG_LEVEL=debug

# --- Auth (Better Auth, F-S01) --------------------------------------------
# Public origin of the auth server; used to build OAuth callback URLs.
BETTER_AUTH_URL=http://localhost:8000
# Session signing secret. Always required; min 32 chars in production.
# Generate: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-me

# The domain the session cookie is written for. LEAVE IT EMPTY LOCALLY: the dev
# stack is all localhost, where every app and the API are the same host and a
# host-only cookie is correct.
#
# Set it on a deployment where the apps and the API are separate hostnames,
# naming the parent they share (leading dot):
#   AUTH_COOKIE_DOMAIN=.injishi.com
#
# Two separate failures make it necessary, and only together do they explain
# why the obvious half-fix does not work. Better Auth's default cookie is
# host-only with `SameSite=Lax`:
#   - `Lax` is never returned on a cross-SITE request, so an app on
#     `www.injishi.com` cannot carry it to an API on `*.up.railway.app` at all;
#   - host-only means it is not delivered to any OTHER host either, so the pms
#     app's Next.js middleware — which reads the cookies sent to ITS OWN origin
#     before it renders anything — cannot see it even once the API is a sibling
#     subdomain. That gate then bounces a signed-in operator to sign-in forever.
# Naming the shared parent answers both, and without widening `SameSite` to
# `None`, because every `*.injishi.com` origin is then same-site.
#
# IT ONLY WORKS IF THIS API IS SERVED FROM THAT DOMAIN. A response may not set
# a cookie for a domain its own host is not in; the browser drops it silently,
# with no error anywhere. So this and the API's public hostname are configured
# in the same change, or not at all.
AUTH_COOKIE_DOMAIN=

# Google OAuth credentials. Authorized redirect URI to register:
#   http://localhost:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The phone app's builds a sign in may return to, beyond `injishi://` (always
# trusted) and `injishi-dev://` (trusted outside NODE_ENV=production). Comma
# separated, each one of the app's own `injishi-<name>` schemes; anything else
# refuses the boot. Staging sets injishi-preview; production leaves it unset.
# MOBILE_EXTRA_SCHEMES=

# --- Email (nodemailer over SMTP) ---------------------------------------------
# Where every message goes. Locally that is the Mailpit in
# infra/docker/docker-compose.yml: it catches everything, nothing reaches a real
# mailbox, and a sign-in code is read at http://localhost:8025. A failed send
# is an error, unless OTP_DEBUG_LOG below prints the code instead.
#
# Production names a real relay (smtps://resend:<api key>@smtp.resend.com:465)
# and refuses to boot without one. Staging points at its own Mailpit.
SMTP_URL=smtp://localhost:1025
# The sender. Deployed, it must be a domain the relay may send for.
MAIL_FROM=Injishi <no-reply@injishi.com>
# Web's public origin, for a mail that links to a page on web (the owner claim
# invitation, ADR-053). An origin with no path. Unset here it defaults to
# http://localhost:3000; under NODE_ENV=production the API refuses to boot
# without it.
WEB_URL=http://localhost:3000
# The app's public origin (apps/app), for a mail that opens a page in the app:
# a lease invitation, a tenant's lease, a landlord's lease record. An origin
# with no path. Unset here it defaults to http://localhost:3002; under
# NODE_ENV=production the API refuses to boot without it.
APP_URL=http://localhost:3002

# --- Object storage (S3 API, MinIO) ---------------------------------------------
# `live` stores through the S3 API; `local` writes to disk under
# STORAGE_LOCAL_ROOT (.storage by default) and needs nothing running, but it is
# not what any deployment runs, so live is the default here too.
STORAGE_ADAPTER_MODE=live
# Where the API reaches S3: the local compose's MinIO, on the port it publishes
# (9000 unless you changed it). Deployed, it is the compose-internal address.
STORAGE_S3_ENDPOINT=http://localhost:9000
# The origin written into signed URLs, so it must be one a browser can reach.
# Locally the same as the endpoint; deployed, the public storage host
# (https://storage.injishi.com) while the endpoint stays internal.
STORAGE_S3_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
# The local MinIO's ROOT pair, which is fine on a laptop and nowhere else.
# Deployed stacks hand the API a user minio-init creates, limited to object
# read, write and delete on its buckets (infra/docker/minio/provision.sh).
STORAGE_S3_ACCESS_KEY=injishi
STORAGE_S3_SECRET_KEY=injishi-dev
STORAGE_BUCKET=injishi
# Create a missing bucket at boot, so a fresh MinIO works with no setup step.
# Development only: refused under NODE_ENV=production, where minio-init
# provisions the buckets and the API only checks they exist.
STORAGE_CREATE_BUCKETS=true
# Refuse to boot unless the bucket has default encryption. On by
# default under NODE_ENV=production; off here because a local MinIO without a
# KMS key cannot encrypt at all.
STORAGE_REQUIRE_ENCRYPTION=false

# Print OTP codes to the log when delivery fails, so sign-in is exercisable
# without a mail provider. A printed code is a working credential — anyone who
# can read the log can sign in as anyone. Local dev only; force-disabled when
# NODE_ENV=production, and it must never be set on a shared/staging host.
OTP_DEBUG_LOG=true

# --- The demo ----------------------------------------------------------------
# The demo is its own stack (ADR-043, infra/docker/docker-compose.demo.yml):
# its own API, worker, database, Redis, MinIO and Mailpit. Nothing in this file
# configures it, and the old in process split (DEMO_DATABASE_URL,
# DEMO_HOSTNAMES, DEMO_AUTH_SECRET, DEMO_AUTH_URL, STORAGE_DEMO_BUCKET,
# INJISHI_WORKER_ENVIRONMENT, DEV_DATABASE_URL) is gone: those lines do nothing.
#
# There is deliberately NO setting for the demo sign-in code. It is a constant
# in @injishi/auth, handed to the auth instance only in a demo process, and a
# demo process only boots on a database marked sample, so no environment
# variable can make production issue a fixed code. Do not reintroduce one.

# --- Government oversight console (ADR-018, move 2) -------------------------
#
# The console is a SEPARATE TRUST BOUNDARY, not a second environment. It reads
# the same rows through the same guards; what must never cross is the cookie. A
# field verifier reviewing a business must not be holding a session that
# business's own marketplace could have minted.
#
# Which hostnames the API serves the console's Better Auth on (comma separated).
# It is an ALLOWLIST in one direction only: a host listed here is the console,
# anything else is the marketplace exactly as before. Leave it unset and the
# console is unreachable, which is the right posture when nobody runs one.
OVERSIGHT_HOSTNAMES=oversight.injishi.rw
#
# The console's own signing secret. REQUIRED as soon as any host is listed
# above, and it MUST NOT equal BETTER_AUTH_SECRET. The API refuses to boot if
# they match, because an equal pair removes the whole boundary in silence: every
# screen still renders and each instance simply verifies the other's cookies.
OVERSIGHT_AUTH_SECRET=replace-me-with-a-different-secret
#
# The console's cookie name prefix. Distinct from the marketplace's so the two
# sessions do not overwrite each other in one browser — which is what an officer
# who also runs a hotel would otherwise hit. It must match
# NEXT_PUBLIC_OVERSIGHT_COOKIE_PREFIX in apps/oversight, or that app's gate looks
# for a cookie nobody sets and bounces a signed-in officer forever.
OVERSIGHT_AUTH_COOKIE_NAME=injishi-oversight
#
# The console's auth base URL. Defaults to BETTER_AUTH_URL when unset.
OVERSIGHT_AUTH_BASE_URL=https://oversight.injishi.rw

# --- RRA TIN adapter (F-R*, registration pipeline) --------------------------
# `live` selects the real RRA endpoint; anything else (including unset) selects
# the mock. No endpoint is wired yet, so `live` deliberately returns `pending /
# adapter_unavailable` rather than fabricating a `verified` result — an
# unverified business must never enter the pipeline wearing a verified badge.
#
# DEMO: the mock ALWAYS returns `verified`. RRA has not granted API access, so
# there is no register to disagree with, and a synthetic rejection would stop a
# real business at a gate that never ran. Every row is still stamped
# `adapter_mode = 'mock'`, so a mock verdict can never be read as an RRA one.
# `sandbox` runs the real HTTP adapter (`rra-tin-http.adapter.ts`) against
# Injishi Mock APIs, below: seeded taxpayers with directors, a closed TIN and
# an outage. `live` still refuses to boot until RRA grants access.
RRA_TIN_ADAPTER_MODE=mock

# --- Injishi Mock APIs (server/mock-apis): the providers' sandbox -----------
# One local server standing in for GTBank (NIDA and the Payment Hub), RRA and
# Smile ID, answering from seeded registers. Start it with `pnpm mock-apis:dev`
# from the repository root; its console (people, TINs, passports, wallets,
# demo ID images, pending payments) is at the URL below.
#
# A seam set to `sandbox` sends its requests there with the SAME adapter
# `live` will use, so going live is a base URL and credentials plus whatever
# the provider's real document corrects. Every seam is switched on its own;
# `sandbox` is refused over a database without the sample marker.
#
#   RRA_TIN_ADAPTER_MODE=sandbox     RRA taxpayer register
#   NIDA_ADAPTER_MODE=sandbox        National ID by number + selfie (GTBank's NIDA gateway)
#   DOCUMENT_VERIFIER_MODE=sandbox   passports (Smile ID)
#   PAYMENT_ADAPTER_MODE=sandbox     mobile money (GTBank Payment Hub)
#
# NIDA_ADAPTER_MODE and DOCUMENT_VERIFIER_MODE, unset, are `mock` over a sample
# database and `off` over a real one.
# MOCK_APIS_URL=http://localhost:8100
# MOCK_APIS_SECRET=injishi-mock-apis-dev-secret

# --- Payments: the mock mobile money rail (ADR-047 D-j) --------------------
# The mock adapter models a HANDSET. A mobile money capture comes back
# `pending`, exactly as MTN and Airtel answer one, and settles a few seconds
# later as though the customer approved it on `*182#`. A card settles inside
# the call, because a card rail does.
#
# It used to report everything as instantly settled, and its own comment said
# why: the booking path refused an unsettled capture with a 402, so a truthful
# mock "would refuse every booking in development". That is fixed — the wait is
# a real, durable state now — so the demo can tell the truth about the rail and
# the async path gets exercised every single time somebody walks the flow.
#
# How long the imaginary customer takes to approve. `0` settles on the first
# poll, which is what the tests use; the default is 6s.
MOCK_MOMO_APPROVAL_MS=6000
#
# THE DECLINE HOOK IS THE NUMBER, not a variable: a payer MSISDN ending `0000`
# is refused, so the "your payment was declined" path can be walked from the
# checkout without editing code. Real providers publish test numbers that work
# exactly this way. `078 812 0000` is the one to type.

# --- RRA EBM invoicing (F-B13, ADR-041) ------------------------------------
# `mock` (the default) prints the RRA receipt layout over FABRICATED device
# fields and says so on the paper; nothing is sent to RRA. `live` certifies each
# confirmed sale ONCE through the business's own account at the Injishi EBM
# provider, from the EbmEmission queue, and prints the VSDC's answer. Any other
# value refuses to boot, and so does `live` with any EBM_* key below missing.
VSDC_ADAPTER_MODE=mock
#
# The provider. Test: https://test-ebm-api.injishi.com. Must be https (plain http
# is accepted only for localhost): bearer tokens and the client secret ride it.
EBM_API_BASE_URL=https://test-ebm-api.injishi.com
#
# The OAuth client the provider issued to Injishi (Authorization Code + PKCE;
# the provider offers no machine grant). The redirect URI must be registered
# with the provider byte for byte, and must reach this API's
# GET /api/v1/ebm/oauth/callback.
EBM_OAUTH_CLIENT_ID=
EBM_OAUTH_CLIENT_SECRET=
EBM_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/ebm/oauth/callback
#
# Where the taxpayer lands after consent: the operator app's Settings >
# Integrations screen. `{workspaceId}` is filled in from the business the consent
# was for (an expired or forged consent names none and goes to the app's front
# door). The API appends ?ebm=connected or ?ebm=error&reason=<code>.
EBM_CONNECT_RETURN_URL=http://localhost:3002/w/{workspaceId}/settings/integrations
#
# Opens the stored OAuth tokens (AES-256-GCM). Exactly 32 bytes, base64:
#   openssl rand -base64 32
# Losing it disconnects every business (their tokens become unreadable); leaking
# it hands out every business's power to issue invoices. Never commit a real one.
EBM_TOKEN_ENCRYPTION_KEY=
#
# The first instant whose confirmed sales are certified. The worker's reconcile
# sweep certifies any confirmed sale from here on that has no emission row, and
# nothing before it is ever sent — so switching live on never backfills
# demo-era bookings into a taxpayer's RRA record. ISO date or instant.
EBM_LIVE_SINCE=2026-09-11T00:00:00+02:00
#
# Per call ceiling for the provider, 1000..120000 ms. Default 20000.
# EBM_API_TIMEOUT_MS=20000

# --- Support assistant (ADR-061) ---------------------------------------------
# off | mock | live. Unset means off under NODE_ENV=production and mock
# everywhere else, so a laptop answers from the knowledge base with no key.
ASSISTANT_ADAPTER_MODE=mock
# The model for live mode. Default claude-sonnet-5-5.
# ASSISTANT_MODEL=claude-sonnet-5-5
# Required when ASSISTANT_ADAPTER_MODE=live; a live process without it refuses
# to boot. Never commit a real key.
# ANTHROPIC_API_KEY=
# The ceiling on a UTC month's estimated model cost, in US dollars (D-t). Once
# reached, the model is not called and answers fall back to the closest help
# article or the offer of a person until the month turns. A warning tagged
# ASSISTANT_BUDGET is logged at 80% and 100%. Unset means no ceiling, which a
# live process says in its boot log; set one before going live.
# ASSISTANT_MONTHLY_BUDGET_USD=50
# Model answered turns per signed in person per Kigali day, and per
# conversation when signed out. Default 30; past it, answers fall back.
# ASSISTANT_AI_TURNS_PER_DAY=30
# One model call's output ceiling in tokens (D-y), 256 to 8000. Answers are
# asked to stay under 120 words; adaptive thinking shares this budget. A call
# that hits it is recorded as truncated; tune on that count, never raise it to
# lengthen answers. Default 1500.
# ASSISTANT_MAX_OUTPUT_TOKENS=1500
# What the usage ledger prices a call at, US dollars per million tokens (D-s).
# Defaults are Claude Sonnet 5.5's published prices on 2026-10-01; change them
# with the model or the price list. Read the month with
# node scripts/assistant-usage.mjs YYYY-MM.
# ASSISTANT_PRICE_INPUT_PER_MTOK_USD=2
# ASSISTANT_PRICE_OUTPUT_PER_MTOK_USD=10
# ASSISTANT_PRICE_CACHE_READ_PER_MTOK_USD=0.2
# ASSISTANT_PRICE_CACHE_WRITE_PER_MTOK_USD=2.5
