# server/api, TEST: the local disposable stack on your laptop, and the tests.
#
# Committed on purpose: every value here is local and made up, so it is safe in
# git and the same for everyone. Nothing in it reaches a real service.
#
#   pnpm dev:stack          start Postgres, Redis and Mailpit, migrate, seed
#   pnpm dev:stack:reset    wipe them and start again from a clean database
#   pnpm api:dev:test       run the API against this stack (http://localhost:8000)
#
# Seeds and verify scripts read this file unless APP_ENV names another.
# Want other ports on your machine? Edit them here and don't commit the change,
# or set the variable in your shell, which always wins.

# NODE_ENV is left to the runner: Vitest sets `test`, `pnpm api:dev:test` leaves
# it unset (development behaviour).
INJISHI_PROCESS=http
PORT=8000

# A TESTING database, not the demo (2026-10-24): the API runs as production
# (INJISHI_ENVIRONMENT=production), so sign-in codes are real random codes,
# read in Mailpit at http://localhost:8025, and there is no persona picker and
# no fixed code. The database is marked sample (INJISHI_DATABASE_KIND=sample),
# which is what lets payments, SMS and identity checks stay on their mock
# adapters, exactly like staging. It holds reference data (geography, RDB
# classes, amenities, government bodies, tax rates) and test settings only:
# no demo people, businesses or homes. Everyone is created through the real
# flows while testing.
INJISHI_ENVIRONMENT=production
INJISHI_DATABASE_KIND=sample

# What `pnpm dev:stack` seeds: `reference` (the testing database above) or
# `sample` (the old demo world: personas, hotels, residences, code 123456;
# pair it with INJISHI_ENVIRONMENT=demo).
STACK_SEED=reference
# The first Injishi admin, created by the stack (scripts/grant-staff.mjs) so
# someone can approve businesses and assign local leaders. Sign in with it at
# /sign-in like anyone else; the code arrives in Mailpit.
TEST_ADMIN_EMAIL=admin@injishi.test

# --- Database and Redis (Docker, started by `pnpm dev:stack`) ---------------
DATABASE_URL=postgres://injishi:injishi@127.0.0.1:5434/injishi
REDIS_HOST=127.0.0.1
REDIS_PORT=6381

# --- Secrets: local only, never used anywhere else --------------------------
COOKIE_SECRET=test-only-cookie-secret-change-nothing-here
BETTER_AUTH_SECRET=test-only-auth-secret-change-nothing-here
HR_PIN_PEPPER=test-only-hr-pin-pepper-change-nothing-here
# Seals landlords' bank account numbers (payout accounts). Base64 of 32 bytes; this one is test-only.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=dGVzdC1vbmx5LXBheW91dC1rZXktY2hhbmdlLW5vbmU=

# --- HTTP, auth and logging ---------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
LOG_LEVEL=debug
BETTER_AUTH_URL=http://localhost:8000
AUTH_COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (local Mailpit: http://localhost:8025) ---------------------------
SMTP_URL=smtp://127.0.0.1:15025
MAIL_FROM=Injishi Test <no-reply@injishi.test>
WEB_URL=http://localhost:3000
# The app (apps/app), where rentals emails link: invitations, leases.
APP_URL=http://localhost:3002
OTP_DEBUG_LOG=true

# --- Object storage: files on disk, nothing to run ---------------------------
STORAGE_ADAPTER_MODE=local
STORAGE_BUCKET=injishi
STORAGE_CREATE_BUCKETS=true
STORAGE_REQUIRE_ENCRYPTION=false

# --- Government oversight console -------------------------------------------
OVERSIGHT_HOSTNAMES=
OVERSIGHT_AUTH_SECRET=test-only-oversight-secret-not-the-auth-one
OVERSIGHT_AUTH_COOKIE_NAME=injishi-oversight

# --- Adapters (all mocked) ----------------------------------------------------
RRA_TIN_ADAPTER_MODE=mock
MOCK_MOMO_APPROVAL_MS=6000
VSDC_ADAPTER_MODE=mock
EBM_API_BASE_URL=https://test-ebm-api.injishi.com
EBM_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/ebm/oauth/callback
EBM_CONNECT_RETURN_URL=http://localhost:3002/w/{workspaceId}/settings/integrations
EBM_LIVE_SINCE=2026-09-11T00:00:00+02:00
ASSISTANT_ADAPTER_MODE=mock
