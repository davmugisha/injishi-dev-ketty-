# server/api, DEVELOPMENT: your laptop's API against the hosted dev services.
#
# Copy to `.env.development` (gitignored) and fill in the values a teammate
# shares with you privately. Never commit the copy and never paste it in chat.
# `pnpm api:dev` reads it. Every variable is explained in .env.example.

NODE_ENV=development
INJISHI_PROCESS=http
PORT=8000

# --- Database and Redis (hosted dev server) ---------------------------------
DATABASE_URL=postgres://injishi_dev:<password>@<dev-host>:5433/injishi?sslmode=no-verify
PG_POOL_MAX=4
PG_CONNECT_TIMEOUT_MS=15000
REDIS_URL=redis://dev:<password>@<dev-host>:6380

# --- Secrets (`openssl rand -base64 32` each, or the team's shared values) ----
COOKIE_SECRET=
BETTER_AUTH_SECRET=
HR_PIN_PEPPER=
PAYOUT_ACCOUNT_ENCRYPTION_KEY=

# --- HTTP, auth and logging ---------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
LOG_LEVEL=debug
BETTER_AUTH_URL=http://localhost:8000
AUTH_COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (the dev server's Mailpit) ---------------------------------------
SMTP_URL=smtp://dev:<password>@<dev-host>:1025
MAIL_FROM=Injishi Dev <no-reply@staging.injishi.com>
WEB_URL=http://localhost:3000
APP_URL=http://localhost:3002
OTP_DEBUG_LOG=false

# --- Object storage (staging S3) --------------------------------------------
STORAGE_ADAPTER_MODE=live
STORAGE_S3_ENDPOINT=https://storage-staging.injishi.com
STORAGE_S3_PUBLIC_ENDPOINT=https://storage-staging.injishi.com
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=injishi-api
STORAGE_S3_SECRET_KEY=
STORAGE_BUCKET=injishi
STORAGE_CREATE_BUCKETS=false
STORAGE_REQUIRE_ENCRYPTION=true

# --- Government oversight console (its secret must differ from BETTER_AUTH_SECRET)
OVERSIGHT_HOSTNAMES=oversight.injishi.rw
OVERSIGHT_AUTH_SECRET=
OVERSIGHT_AUTH_COOKIE_NAME=injishi-oversight
OVERSIGHT_AUTH_BASE_URL=https://oversight.injishi.rw

# --- Adapters (all mocked in development) -----------------------------------
RRA_TIN_ADAPTER_MODE=mock
MOCK_MOMO_APPROVAL_MS=6000
VSDC_ADAPTER_MODE=mock
EBM_API_BASE_URL=https://test-ebm-api.injishi.com
EBM_OAUTH_CLIENT_ID=
EBM_OAUTH_CLIENT_SECRET=
EBM_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/ebm/oauth/callback
EBM_CONNECT_RETURN_URL=http://localhost:3002/w/{workspaceId}/settings/integrations
EBM_TOKEN_ENCRYPTION_KEY=
EBM_LIVE_SINCE=2026-09-11T00:00:00+02:00
ASSISTANT_ADAPTER_MODE=mock
