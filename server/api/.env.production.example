# server/api, PRODUCTION: what the API process needs in production.
#
# NOT a file to fill in on a laptop. Production runs in Docker on Dokploy, and
# its variables live in Dokploy's environment settings, which the deploy writes
# into the stack (infra/docker/DOKPLOY.md, infra/docker/dokploy.env.example).
# The image never carries an env file (.dockerignore drops them all), so a
# `.env.production` is only for running a production build by hand, and must
# never be committed.
#
# The API refuses to boot under NODE_ENV=production when a REQUIRED value is
# missing or still a placeholder. Every variable is explained in .env.example.

NODE_ENV=production
INJISHI_PROCESS=http
PORT=8000

# Which platform this is (ADR-043). The deploy compose pins both.
INJISHI_ENVIRONMENT=production
INJISHI_DATABASE_KIND=real

# --- REQUIRED: database and Redis -------------------------------------------
DATABASE_URL=
REDIS_URL=

# --- REQUIRED: secrets, min 32 chars each (`openssl rand -base64 32`) ---------
COOKIE_SECRET=
BETTER_AUTH_SECRET=
HR_PIN_PEPPER=
# Base64 of exactly 32 bytes: seals landlords' bank account numbers.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=

# --- REQUIRED: HTTP and auth --------------------------------------------------
CORS_ORIGINS=https://www.injishi.com,https://injishi.com,https://app.injishi.com,https://admin.injishi.com
TRUST_PROXY=1
LOG_LEVEL=info
BETTER_AUTH_URL=https://api.injishi.com
AUTH_COOKIE_DOMAIN=.injishi.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- REQUIRED: email (a real relay) -----------------------------------------
SMTP_URL=
MAIL_FROM=Injishi <no-reply@injishi.com>
WEB_URL=https://www.injishi.com
# Forced off in production whatever it says.
OTP_DEBUG_LOG=false

# --- REQUIRED: object storage -----------------------------------------------
STORAGE_ADAPTER_MODE=live
STORAGE_S3_ENDPOINT=
STORAGE_S3_PUBLIC_ENDPOINT=https://storage.injishi.com
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_BUCKET=injishi
STORAGE_CREATE_BUCKETS=false
STORAGE_REQUIRE_ENCRYPTION=true

# --- Government oversight console (its secret must differ from BETTER_AUTH_SECRET)
OVERSIGHT_HOSTNAMES=oversight.injishi.rw
OVERSIGHT_AUTH_SECRET=
OVERSIGHT_AUTH_COOKIE_NAME=injishi-oversight
OVERSIGHT_AUTH_BASE_URL=https://oversight.injishi.rw

# --- Adapters -----------------------------------------------------------------
RRA_TIN_ADAPTER_MODE=mock
VSDC_ADAPTER_MODE=mock
EBM_API_BASE_URL=
EBM_OAUTH_CLIENT_ID=
EBM_OAUTH_CLIENT_SECRET=
EBM_OAUTH_REDIRECT_URI=https://api.injishi.com/api/v1/ebm/oauth/callback
EBM_CONNECT_RETURN_URL=https://app.injishi.com/w/{workspaceId}/settings/integrations
EBM_TOKEN_ENCRYPTION_KEY=
EBM_LIVE_SINCE=
ASSISTANT_ADAPTER_MODE=off
# ANTHROPIC_API_KEY=
# ASSISTANT_MONTHLY_BUDGET_USD=
