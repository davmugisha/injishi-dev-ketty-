{
  "name": "injishi",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@heroui-pro/react",
      "esbuild",
      "msgpackr-extract",
      "sharp"
    ],
    "overrides": {
      "@types/react": "19.1.17",
      "@types/react-dom": "19.1.11"
    },
    "ignoredBuiltDependencies": [
      "@zowe/secrets-for-zowe-sdk"
    ],
    "packageExtensions": {
      "@heroui-pro/react@1.0.0-beta.10": {
        "peerDependencies": {
          "@heroui/react": ">=3.2.6",
          "@heroui/styles": ">=3.2.6",
          "@number-flow/react": ">=0.5.0",
          "@react-aria/utils": ">=3.34.1",
          "@tiptap/core": ">=3.23.6",
          "@tiptap/extension-link": ">=3.23.6",
          "@tiptap/extension-underline": ">=3.23.6",
          "@tiptap/extensions": ">=3.23.6",
          "@tiptap/pm": ">=3.23.6",
          "@tiptap/react": ">=3.23.6",
          "@tiptap/starter-kit": ">=3.23.6",
          "@tiptap/suggestion": ">=3.23.6",
          "embla-carousel": ">=8.6.0",
          "embla-carousel-react": ">=8.6.0",
          "maplibre-gl": ">=6.0.0",
          "marked": ">=18.0.0",
          "motion": ">=12.12.0",
          "react": ">=19.0.0",
          "react-aria": ">=3.52.1",
          "react-aria-components": ">=1.21.1",
          "react-dom": ">=19.0.0",
          "react-markdown": ">=10.1.0",
          "react-resizable-panels": ">=4.10.0",
          "react-stately": ">=3.50.0",
          "recharts": ">=2.0.0",
          "remark-breaks": ">=4.0.0",
          "remark-gfm": ">=4.0.0",
          "shiki": ">=4.0.0",
          "streamdown": ">=2.5.0",
          "tailwind-merge": ">=3.4.0",
          "tailwind-variants": ">=3.3.1",
          "tailwindcss": ">=4.0.0"
        },
        "peerDependenciesMeta": {
          "@number-flow/react": {
            "optional": true
          },
          "@tiptap/core": {
            "optional": true
          },
          "@tiptap/extension-link": {
            "optional": true
          },
          "@tiptap/extension-underline": {
            "optional": true
          },
          "@tiptap/extensions": {
            "optional": true
          },
          "@tiptap/pm": {
            "optional": true
          },
          "@tiptap/react": {
            "optional": true
          },
          "@tiptap/starter-kit": {
            "optional": true
          },
          "@tiptap/suggestion": {
            "optional": true
          },
          "embla-carousel": {
            "optional": true
          },
          "embla-carousel-react": {
            "optional": true
          },
          "maplibre-gl": {
            "optional": true
          },
          "marked": {
            "optional": true
          },
          "react-markdown": {
            "optional": true
          },
          "recharts": {
            "optional": true
          },
          "remark-breaks": {
            "optional": true
          },
          "remark-gfm": {
            "optional": true
          },
          "shiki": {
            "optional": true
          },
          "streamdown": {
            "optional": true
          }
        }
      }
    }
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:ci": "pnpm -r --workspace-concurrency=1 --filter=!@injishi/mobile test",
    "build": "pnpm --filter @injishi/web --filter @injishi/app --filter @injishi/admin --filter @injishi/api build",
    "check:manifests": "node scripts/check-workspace-manifests.mjs",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "dev": "pnpm --filter @injishi/web dev",
    "dev:all": "node scripts/dev-all.mjs",
    "web:dev": "pnpm --filter @injishi/web dev",
    "web:build": "pnpm --filter @injishi/web build",
    "web:start": "pnpm --filter @injishi/web start",
    "web:tokens:sync": "pnpm --filter @injishi/web tokens:sync",
    "app:dev": "pnpm --filter @injishi/app dev",
    "app:build": "pnpm --filter @injishi/app build",
    "app:start": "pnpm --filter @injishi/app start",
    "mobile:start": "pnpm --filter @injishi/mobile start",
    "api:dev": "pnpm --filter @injishi/api dev",
    "api:build": "pnpm --filter @injishi/api build",
    "api:start": "pnpm --filter @injishi/api start",
    "api:worker": "pnpm --filter @injishi/api worker",
    "api:worker:dev": "pnpm --filter @injishi/api worker:dev",
    "db:seed": "pnpm --filter @injishi/api db:seed",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:stack:down": "node scripts/dev-stack.mjs --down",
    "dev:stack:reset": "node scripts/dev-stack.mjs --reset"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11"
  }
}
