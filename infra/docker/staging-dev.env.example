# A developer laptop on staging's backing services: copy to server/api/.env.
#
# The API runs from source on the laptop (`pnpm api:dev`), and so do the
# frontends, but Postgres, Redis (BullMQ), MinIO and Mailpit are staging's, on
# the VPS, so nothing runs in Docker locally. DOKPLOY.md, Developer access to
# staging, owns the ports and the rules; the change-me values are staging's
# Dokploy variables of the same name, which the team lead hands out.
#
# THIS IS SHARED DATA. Every laptop and the deployed staging API read and write
# the same database and the same queues. Never run `pnpm db:migrate` from a
# branch here, never run a worker (`worker:dev`), never reseed or reset.

NODE_ENV=development
# http only. Staging's own worker drains every queue.
INJISHI_PROCESS=http
PORT=8000

# --- Postgres, as injishi_dev, TLS only -------------------------------------
# `no-verify` encrypts without checking the certificate, which node-postgres
# cannot do against an IP. psql and GUI clients take `sslmode=require` instead.
# Once db-staging.injishi.com resolves, use the name with
# `sslmode=verify-full&sslrootcert=<path to staging-db-ca.crt>`.
DATABASE_URL=postgres://injishi_dev:<STAGING_DB_DEV_PASSWORD>@102.202.208.167:5433/injishi?sslmode=no-verify
# A laptop's share of the 40 connections injishi_dev may hold.
PG_POOL_MAX=4
# Round trips cross the internet, so give a connection time to open.
PG_CONNECT_TIMEOUT_MS=15000

# Leave both unset: the laptop runs as the demo platform on a sample database,
# so every seeded account signs in with 123456. INJISHI_ENVIRONMENT=production
# gives random codes instead, read in the inbox at mail-staging.injishi.com.
# INJISHI_ENVIRONMENT=
# INJISHI_DATABASE_KIND=

# --- Redis (BullMQ), as `dev` ------------------------------------------------
REDIS_URL=redis://dev:<REDIS_DEV_PASSWORD>@102.202.208.167:6380

# --- This laptop's own secrets, never staging's --------------------------------
# openssl rand -base64 32, each. A laptop session opens nothing on api-staging.
COOKIE_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
# Staging's, because kiosk PINs are hashed with it into the shared database.
HR_PIN_PEPPER=<HR_PIN_PEPPER>

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
LOG_LEVEL=debug
BETTER_AUTH_URL=http://localhost:8000
AUTH_COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mail: staging's Mailpit, as `dev` ---------------------------------------
# Read what was sent at https://mail-staging.injishi.com (MAILPIT_UI_USER and
# MAILPIT_UI_PASSWORD).
SMTP_URL=smtp://dev:<MAILPIT_SMTP_DEV_PASSWORD>@102.202.208.167:1025
MAIL_FROM=Injishi Dev <no-reply@staging.injishi.com>
WEB_URL=http://localhost:3000
# A printed code is a working credential on shared data.
OTP_DEBUG_LOG=false

# --- Object storage: staging's MinIO, through its storage host -----------------
STORAGE_ADAPTER_MODE=live
STORAGE_S3_ENDPOINT=https://storage-staging.injishi.com
STORAGE_S3_PUBLIC_ENDPOINT=https://storage-staging.injishi.com
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=injishi-api
STORAGE_S3_SECRET_KEY=<STORAGE_S3_SECRET_KEY>
STORAGE_BUCKET=injishi
# The bucket exists and is encrypted; the API's user may not create one.
STORAGE_CREATE_BUCKETS=false
STORAGE_REQUIRE_ENCRYPTION=true

# --- Everything else as server/api/.env.example --------------------------------
OVERSIGHT_HOSTNAMES=oversight.injishi.rw
# Must differ from BETTER_AUTH_SECRET, or the API refuses to boot.
OVERSIGHT_AUTH_SECRET=change-me-a-different-secret
OVERSIGHT_AUTH_COOKIE_NAME=injishi-oversight
OVERSIGHT_AUTH_BASE_URL=https://oversight.injishi.rw
RRA_TIN_ADAPTER_MODE=mock
MOCK_MOMO_APPROVAL_MS=6000
VSDC_ADAPTER_MODE=mock
EBM_API_BASE_URL=https://test-ebm-api.injishi.com
EBM_OAUTH_CLIENT_ID=
EBM_OAUTH_CLIENT_SECRET=
EBM_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/ebm/oauth/callback
EBM_CONNECT_RETURN_URL=http://localhost:3002/w/{workspaceId}/settings/integrations
EBM_TOKEN_ENCRYPTION_KEY=
EBM_LIVE_SINCE=2026-09-11T00:00:00+02:00
ASSISTANT_ADAPTER_MODE=mock
