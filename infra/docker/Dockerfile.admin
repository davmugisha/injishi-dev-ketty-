# Build and run apps/admin (the staff console, F-A*).
#
# Built from the repository ROOT so the workspace packages resolve:
#   docker build -f infra/docker/Dockerfile.admin -t injishi-admin .
#
# Same shape as Dockerfile.web: every workspace member's package.json is copied
# before the install, because pnpm-workspace.yaml globs apps/*, server/*,
# packages/* and a frozen install fails when a member the lockfile names is
# missing.
#
# NEXT_PUBLIC_* are ARG/ENV on the build stage because Next inlines them at
# compile time. One image serves ONE environment: production and demo are two
# builds of this file with different arguments.
#
# The console is gated twice before a staffer sees it: Traefik refuses any IP
# outside ADMIN_ALLOWED_IPS (the compose labels), then src/middleware.ts refuses
# a request with no live session. Neither is the boundary; the Admin API's
# SessionGuard and StaffGuard are.
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /repo

# ---- dependencies ----------------------------------------------------------
# Manifests only, so a source edit does not re-run the install.
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY apps/app/package.json ./apps/app/
COPY apps/admin/package.json ./apps/admin/
COPY apps/mobile/package.json ./apps/mobile/
COPY server/api/package.json ./server/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/qr/package.json ./packages/qr/
COPY packages/design-tokens/package.json ./packages/design-tokens/
COPY packages/ui/package.json ./packages/ui/
COPY packages/ui-contract/package.json ./packages/ui-contract/
COPY packages/utils/package.json ./packages/utils/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @injishi/admin...

# ---- build -----------------------------------------------------------------
FROM base AS build
COPY --from=deps /repo ./
COPY packages ./packages
COPY apps/admin ./apps/admin
# Standalone output is opt-in; see apps/admin/next.config.ts.
# The public origins have NO default: a default of production's origins let a
# staging or demo build that forgot one ship a console calling production. Each
# compose file passes all three; the RUN below refuses a build missing one.
ARG NEXT_PUBLIC_API_URL
# Where sign-in lives. The console has no sign-in screen of its own.
ARG NEXT_PUBLIC_WEB_URL
# This console's own public origin, for the round trip back from sign-in.
ARG NEXT_PUBLIC_ADMIN_URL
# `demo` for the demo stack's image and nothing else (ADR-043, AC-14): the
# middleware's strip of production's session cookies. Empty means production.
ARG NEXT_PUBLIC_INJISHI_ENVIRONMENT=
ENV NEXT_TELEMETRY_DISABLED=1 \
    BUILD_STANDALONE=1 \
    NEXT_PUBLIC_INJISHI_ENVIRONMENT=$NEXT_PUBLIC_INJISHI_ENVIRONMENT \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL \
    NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL
RUN : "${NEXT_PUBLIC_API_URL:?build arg NEXT_PUBLIC_API_URL is required (API public origin)}" \
 && : "${NEXT_PUBLIC_WEB_URL:?build arg NEXT_PUBLIC_WEB_URL is required (web public origin, where sign-in lives)}" \
 && : "${NEXT_PUBLIC_ADMIN_URL:?build arg NEXT_PUBLIC_ADMIN_URL is required (this console's public origin)}"
RUN pnpm --filter @injishi/admin build

# ---- run -------------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3001 HOSTNAME=0.0.0.0
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

COPY --from=build --chown=nextjs:nodejs /repo/apps/admin/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /repo/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build --chown=nextjs:nodejs /repo/apps/admin/public ./apps/admin/public

USER nextjs
EXPOSE 3001
# Every page sits behind the session gate, which redirects to web's sign-in.
# `/favicon.ico` is outside the gate's matcher, and `redirect: manual` keeps a
# probe from following anything off this container: any answer below 500 means
# the server is up.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:3001/favicon.ico',{redirect:'manual'}).then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/admin/server.js"]
