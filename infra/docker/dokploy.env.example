# Production: /opt/injishi/.env on the VPS, read by docker-compose.dokploy.yml.
# Replace every change-me. Never commit live values.
# Generate secrets with: openssl rand -base64 32
#
# Production only. The demo is its own stack with its own env file
# (dokploy-demo.env.example, /opt/injishi-demo/.env). Nothing demo belongs here,
# and INJISHI_ENVIRONMENT / INJISHI_DATABASE_KIND are pinned in the compose file,
# never set here (ADR-043).

# --- Public hosts ------------------------------------------------------------
# The defaults in the compose file are these values; set them only to change a
# host.
WEB_HOST=www.injishi.com
APEX_HOST=injishi.com
APP_HOST=app.injishi.com
API_HOST=api.injishi.com
ADMIN_HOST=admin.injishi.com
AUTH_COOKIE_DOMAIN=.injishi.com

# Who may open admin (comma separated IPs or CIDRs). Unset means loopback only,
# which closes the console: set it to your office or VPN egress.
ADMIN_ALLOWED_IPS=change-me

# --- Postgres (db service) ------------------------------------------------------
POSTGRES_USER=injishi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=injishi
DATABASE_URL=postgres://injishi:change-me@db:5432/injishi

# --- API and worker ---------------------------------------------------------------
REDIS_URL=redis://redis:6379
COOKIE_SECRET=change-me
BETTER_AUTH_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info

# --- Mail (API and worker) --------------------------------------------------------
# The SMTP relay every message leaves through. Required: compose refuses to
# start without it. smtps:// on 465, or smtp:// for STARTTLS on 587. Resend's
# relay, for example (the key must be allowed to send for MAIL_FROM's domain):
#   SMTP_URL=smtps://resend:<api key>@smtp.resend.com:465
SMTP_URL=change-me
MAIL_FROM=Injishi <no-reply@injishi.com>

# --- Object storage (minio, minio-init, API and worker) ---------------------------
# Root answers on the public storage host, so a long random password, never a
# placeholder. Only minio-init uses root; the API gets the user below.
MINIO_ROOT_USER=injishi
MINIO_ROOT_PASSWORD=change-me
# Encrypts every object at rest. Format <key-name>:<base64 of 32 random bytes>:
#   echo "injishi-key:$(openssl rand -base64 32)"
# Set it once. Lose it or change it and every stored object is unreadable, so
# keep a copy somewhere other than this host.
MINIO_KMS_SECRET_KEY=change-me
# Where browsers fetch signed URLs. DNS only, like every other host here.
STORAGE_HOST=storage.injishi.com
STORAGE_BUCKET=injishi
# The API's own MinIO user, created by minio-init and limited to object read,
# write and delete on the bucket. Never the root pair above.
STORAGE_S3_ACCESS_KEY=injishi-api
STORAGE_S3_SECRET_KEY=change-me
# Sentry DSN for the API and worker (the injishi-api project). Empty leaves
# error reporting off: money alarms (STUCK MONEY, UNRECORDED COMPENSATION) and
# what breaks (a 500, a Better Auth fault, a job's last failed attempt, a
# process that dies) then reach only the log. Stays empty until the NCSA
# registration names Sentry (ADR-063 AC-13).
SENTRY_DSN=
