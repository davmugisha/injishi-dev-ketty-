# Staging: /opt/injishi-staging/.env on the VPS, read by
# docker-compose.staging.yml. Replace every change-me. Never reuse a
# production secret here, and never point staging at production data.
# Generate secrets with: openssl rand -base64 32

# --- Domain -------------------------------------------------------------------
# A domain production does NOT use. Production's session cookie is set on
# .injishi.com, so a staging host under injishi.com would be handed live
# production sessions. Staging serves www., app., api., admin., storage. and
# mail. under this.
STAGING_DOMAIN=change-me.example

# Who may open staging's web, admin, storage and mail inbox (comma separated
# IPs or CIDRs). Unset means loopback only, which closes staging to everyone.
STAGING_ALLOWED_IPS=change-me

# --- Postgres (db service) ------------------------------------------------------
POSTGRES_USER=injishi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=injishi
DATABASE_URL=postgres://injishi:change-me@db:5432/injishi

# --- API and worker -------------------------------------------------------------
# Redis asks every connection for a password. The compose file builds the
# stack's own REDIS_URL from REDIS_PASSWORD (user `default`), so REDIS_URL below
# is read only by an older compose file; keep it equal for a rollback.
# Hex keeps both URL safe: openssl rand -hex 32
REDIS_PASSWORD=change-me
REDIS_URL=redis://default:change-me@redis:6379
COOKIE_SECRET=change-me
BETTER_AUTH_SECRET=change-me
# The kiosk PIN pepper (ADR-058). Required; never production's.
HR_PIN_PEPPER=change-me
# Seals landlords' bank account numbers. Required: `openssl rand -base64 32`; never production's.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
# Sandbox or test credentials only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=debug
# Mail goes only to this stack's Mailpit, never a real relay. Mailpit asks every
# sender to sign in: the API as `staging-api`, laptops as `dev` (below).
MAILPIT_SMTP_API_PASSWORD=change-me
# The inbox at mail-staging.injishi.com (basic auth, any IP).
MAILPIT_UI_USER=staging
MAILPIT_UI_PASSWORD=change-me

# --- Developer access (DOKPLOY.md, Developer access to staging) -----------------
# Laptops run the API from source against this stack's Postgres, Redis, MinIO
# and Mailpit. Each login here is a developer's, never the stack's own, so it
# can be rotated without touching the deployed processes. Hex: openssl rand -hex 24
#
# Postgres role injishi_dev, TLS only. Empty switches the login off.
STAGING_DB_DEV_PASSWORD=change-me
# Redis user `dev`, and Mailpit SMTP user `dev`.
REDIS_DEV_PASSWORD=change-me
MAILPIT_SMTP_DEV_PASSWORD=change-me
# Postgres' TLS pair, each a base64 PEM on one line. Self-signed is enough:
#   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
#     -days 3650 -subj "/CN=db-staging.injishi.com" \
#     -addext "subjectAltName=DNS:db-staging.injishi.com,IP:102.202.208.167" \
#     -keyout server.key -out server.crt
#   base64 -w0 server.crt; base64 -w0 server.key
# Unset, Postgres runs without TLS and refuses every connection from outside.
PG_TLS_CERT_B64=
PG_TLS_KEY_B64=
# The host ports, if the defaults are taken.
# STAGING_DB_PUBLIC_PORT=5433
# STAGING_REDIS_PUBLIC_PORT=6380
# STAGING_SMTP_PUBLIC_PORT=1025

# --- Injishi Mock APIs (mock-apis, ADR-077) ---------------------------------------
# Read by mock-apis and by the API's sandbox adapters. 16 characters or more;
# empty means the mock's public dev secret. Never a real provider's credential.
MOCK_APIS_SECRET=change-me-at-least-16-chars
# The console host, behind STAGING_ALLOWED_IPS. Needs an A record to the VPS.
# MOCK_HOST=mock-staging.injishi.com
# Each registration seam is `mock` (in process) unless set here. `sandbox` sends
# its requests to mock-apis with the adapter `live` will use.
# RRA_TIN_ADAPTER_MODE=sandbox
# NIDA_ADAPTER_MODE=sandbox
# DOCUMENT_VERIFIER_MODE=sandbox
# PAYMENT_ADAPTER_MODE=sandbox

# --- Object storage (minio, minio-init, API and worker) ---------------------------
# Every value its own, never production's. Signed URLs name
# storage.<STAGING_DOMAIN>, behind STAGING_ALLOWED_IPS.
MINIO_ROOT_USER=injishi
MINIO_ROOT_PASSWORD=change-me
# <key-name>:<base64 of 32 random bytes>:
#   echo "injishi-staging-key:$(openssl rand -base64 32)"
MINIO_KMS_SECRET_KEY=change-me
STORAGE_BUCKET=injishi
STORAGE_S3_ACCESS_KEY=injishi-api
STORAGE_S3_SECRET_KEY=change-me

# --- Frontend builds (web and app) -----------------------------------------------
# HeroUI Pro's CI/CD token, from heroui.pro/dashboard: the team's, never a
# developer's personal one. The one value every stack shares, because HeroUI
# issues one per licence. Compose hands it to the three builds as a BuildKit
# secret, so it never lands in an image layer. Unset or empty, each of the
# three builds stops at its install step and says so; a rejected token fails
# the install too.
HEROUI_AUTH_TOKEN=change-me
