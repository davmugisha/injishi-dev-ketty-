# Build and run apps/web (public origin; operator routes rewrite to the app zone).
#
# Built from the repository ROOT so workspace packages resolve:
#   docker build -f infra/docker/Dockerfile.web -t injishi-web .
#
# packages/* is the source of the shared packages (ADR-034). There is no
# vendor/ tree and no packages/config member. pnpm-workspace.yaml globs
# apps/*, server/*, packages/* — every member's package.json is copied so
# `pnpm install --frozen-lockfile` matches the lockfile.
#
# OPERATOR_APP_URL and NEXT_PUBLIC_* are ARG/ENV on the build stage because
# next.config.ts rewrites() and Next inlining bake them at compile time.
# Default OPERATOR_APP_URL is the compose service name, not localhost.
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /repo

# ---- dependencies ----------------------------------------------------------
# Manifests only, so a source edit does not re-run the install.
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY apps/app/package.json ./apps/app/
COPY apps/admin/package.json ./apps/admin/
COPY apps/mobile/package.json ./apps/mobile/
COPY server/api/package.json ./server/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/qr/package.json ./packages/qr/
COPY packages/design-tokens/package.json ./packages/design-tokens/
COPY packages/ui/package.json ./packages/ui/
COPY packages/ui-contract/package.json ./packages/ui-contract/
COPY packages/utils/package.json ./packages/utils/
# HeroUI Pro (a paid licence) ships a stub on npm; its postinstall downloads
# the real code with HEROUI_AUTH_TOKEN, the team's CI/CD token (never a
# personal one). It arrives as a BuildKit secret, so it is never written into
# a layer; compose passes it from the stack's .env (`secrets: heroui_token`).
# An empty one stops the build HERE, not at `next build`: Docker's layer cache
# never sees a secret's value, so an install that ran without it would be
# reused, Pro-less, by every later build until the lockfile changed.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    --mount=type=secret,id=heroui_token \
    export HEROUI_AUTH_TOKEN="$(cat /run/secrets/heroui_token 2>/dev/null)"; \
    [ -n "$HEROUI_AUTH_TOKEN" ] || { echo "HEROUI_AUTH_TOKEN is empty: set it in this stack's .env (DOKPLOY.md, Required secrets with no default)" >&2; exit 1; }; \
    pnpm install --frozen-lockfile --filter @injishi/web...

# ---- build -----------------------------------------------------------------
FROM base AS build
COPY --from=deps /repo ./
COPY packages ./packages
COPY apps/web ./apps/web
# Standalone output is opt-in; see apps/web/next.config.ts.
ARG OPERATOR_APP_URL=http://app:3002
# The public origins have NO default. They used to default to production's, so
# a staging or demo build that forgot one silently shipped a bundle calling
# production. Each compose file passes all of them; the RUN below refuses a
# build that is missing one.
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_WEB_URL
ARG NEXT_PUBLIC_API_URL
# Public operator origin is the web origin (the zone), not the app service.
ARG NEXT_PUBLIC_PMS_URL
# The admin console's origin. Web's sign-in screen sends a signed-in staffer
# back only to an origin on its allowlist (src/lib/redirect.ts), and that list
# is inlined here, so an image built without it strands admin at `/`.
ARG NEXT_PUBLIC_ADMIN_URL
# `demo` for the demo stack's image and nothing else (ADR-043, AC-14). It turns
# on the middleware's strip of production's session cookies and decides nothing
# on any screen. Empty means production, which never strips.
ARG NEXT_PUBLIC_INJISHI_ENVIRONMENT=
ENV NEXT_TELEMETRY_DISABLED=1 \
    BUILD_STANDALONE=1 \
    NEXT_PUBLIC_INJISHI_ENVIRONMENT=$NEXT_PUBLIC_INJISHI_ENVIRONMENT \
    OPERATOR_APP_URL=$OPERATOR_APP_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_PMS_URL=$NEXT_PUBLIC_PMS_URL \
    NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL
RUN : "${NEXT_PUBLIC_SITE_URL:?build arg NEXT_PUBLIC_SITE_URL is required (web public origin)}" \
 && : "${NEXT_PUBLIC_WEB_URL:?build arg NEXT_PUBLIC_WEB_URL is required (web public origin)}" \
 && : "${NEXT_PUBLIC_API_URL:?build arg NEXT_PUBLIC_API_URL is required (API public origin)}" \
 && : "${NEXT_PUBLIC_PMS_URL:?build arg NEXT_PUBLIC_PMS_URL is required (operator zone origin, which is web's)}" \
 && : "${NEXT_PUBLIC_ADMIN_URL:?build arg NEXT_PUBLIC_ADMIN_URL is required (admin console origin)}"
RUN pnpm --filter @injishi/web build

# ---- run -------------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
