{
  "private": true,
  "name": "@injishi/web-ui",
  "version": "0.1.0",
  "description": "The marketplace's component library (Radix and HeroUI Pro), the @injishi/ui that apps/web was written against. apps/web installs it under the alias @injishi/ui; the new interface's @injishi/ui belongs to apps/app. Shipped as TypeScript source; Next consumers compile it through transpilePackages (ADR-008).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./pro.css": "./src/pro.css",
    "./*": "./src/components/*.tsx"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "@heroui-pro/react": "1.0.0-beta.10",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@injishi/contracts": "workspace:*",
    "@injishi/ui-contract": "workspace:*",
    "@injishi/utils": "workspace:*",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@react-aria/utils": "3.34.1",
    "@tanstack/react-table": "9.2.6",
    "class-variance-authority": "0.7.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.23.0",
    "motion": "13.5.1",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-day-picker": "9.14.0",
    "react-resizable-panels": "4.14.2",
    "react-stately": "3.50.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/no-tests.mjs"
  },
  "devDependencies": {
    "@injishi/design-tokens": "workspace:*",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.8.3"
  }
}
