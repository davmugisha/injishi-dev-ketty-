{
  "name": "@injishi/db",
  "version": "0.1.0",
  "private": true,
  "description": "Embedded database (libSQL/SQLite + Drizzle ORM). Seeds dummy data from @injishi/data fixtures; swap the driver for a real backend later.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "seed": "tsx src/cli.ts seed",
    "reset": "tsx src/cli.ts reset",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/guard.test.ts"
  },
  "dependencies": {
    "@injishi/data": "workspace:*",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
