{
  "private": true,
  "name": "@injishi/utils",
  "version": "0.1.0",
  "description": "Presentation helpers shared across the Injishi apps and products: cn, en-RW price and date formatting, reading a typed franc amount, search-param builders, receipt rows.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cn": "./src/cn.ts",
    "./format": "./src/format.ts",
    "./url": "./src/url.ts",
    "./money": "./src/money.ts",
    "./francs": "./src/francs.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "typescript": "5.8.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
