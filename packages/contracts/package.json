{
  "private": true,
  "name": "@injishi/contracts",
  "version": "0.1.0",
  "description": "Injishi shared contracts: Zod schemas + inferred TS, the single source of truth consumed by every app and the backend.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
