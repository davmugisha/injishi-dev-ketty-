{
  "name": "@injishi/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Injishi web UI kit on top of HeroUI (OSS + Pro): theme CSS, Icon, device frames and shared building blocks.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./styles/*": "./src/styles/*",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run --silent lint:biome && pnpm run --silent lint:eslint",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "node --test \"tests/*.test.ts\""
  },
  "peerDependencies": {
    "@gravity-ui/icons": "2.22.1",
    "@heroui-pro/react": "1.0.0-beta.10",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "next": ">=15.5.24 <17",
    "react": ">=19.1.0 <20"
  },
  "devDependencies": {
    "@gravity-ui/icons": "2.22.1",
    "@heroui-pro/react": "1.0.0-beta.10",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@injishi/data": "workspace:*",
    "@internationalized/date": "3.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
