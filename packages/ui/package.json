{
  "private": true,
  "name": "@injishi/ui",
  "version": "0.1.0",
  "description": "Radix-based component primitives shared by the Injishi public web surface. Shipped as TypeScript source; Next consumers compile it through transpilePackages (ADR-008).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./*": "./src/components/*.tsx"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@injishi/ui-contract": "workspace:*",
    "@injishi/utils": "workspace:*",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.23.0",
    "react-day-picker": "9.14.0",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"stories/**/*.{ts,tsx}\" \".storybook/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "palette:candidate": "node .storybook/palettes/derive.mjs"
  },
  "devDependencies": {
    "@injishi/design-tokens": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.8.3",
    "vite": "8.3.0"
  }
}
