{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM"],
    // `node` is listed explicitly because the phone plugin hashes codes with
    // node:crypto. Naming it stops TypeScript auto-loading every @types package
    // that happens to be hoisted nearby, which is how a browser-only global
    // silently becomes available to server code.
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "newLine": "crlf",
    "removeComments": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
