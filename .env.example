# Copy to `.env` (and `.env.local` for the HeroUI tokens) and fill in.
# Never commit either: both are gitignored.

# ── HeroUI Pro (install time) ────────────────────────────────────────────────
# CI/CD token from https://heroui.pro/dashboard. Required at install time: the
# @heroui-pro/react postinstall downloads the Pro components with it. Without it
# the install passes and every build that imports Pro fails.
# In CI, set it as a secret (GitHub Actions `secrets.HEROUI_AUTH_TOKEN`).
HEROUI_AUTH_TOKEN=

# Optional: personal token for interactive `npx heroui-pro status|login` on your machine.
HEROUI_PERSONAL_TOKEN=

# ── New interface (apps/app, apps/mobile) ────────────────────────────────────
# Embedded database (libSQL/SQLite). Defaults to file:<repo>/.data/injishi.db
# INJISHI_DB_URL=file:./.data/injishi.db

# Allow one-step demo sign-in shortcuts (/api/demo/sign-in). Dev only.
# INJISHI_DEMO_SHORTCUTS=1

# ── Public (read by the web client; safe to expose) ──────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Server (read by server/api only; never exposed to the client) ──────────
NODE_ENV=development

# Postgres connection string.
DATABASE_URL=postgres://injishi:injishi@localhost:5432/injishi

# RRA EBM
VSDC_ADAPTER_MODE=live
