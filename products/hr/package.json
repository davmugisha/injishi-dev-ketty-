{
  "private": true,
  "name": "@injishi/product-hr",
  "version": "0.1.0",
  "description": "Injishi HR (ADR-074): the screens of people, roster, attendance, leave, payroll and self service. Views and the shapes they draw, with no authority, no secrets and no database: the app mounts the views on its routes and hands them their data, links and actions.",
