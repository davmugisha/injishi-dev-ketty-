    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "typescript": "5.9.3"
  }
